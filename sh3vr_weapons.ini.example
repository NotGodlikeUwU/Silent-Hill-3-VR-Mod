; SH3VR per-weapon visual calibration.
; Copy this file next to sh3.exe as sh3vr_weapons.ini.
; Values are reloaded automatically while the game is running.
;
; Position uses controller-local game units:
; X = right/left, Y = down/up, Z = forward/back.
; Rotation uses degrees around the controller-local axes.
; Set ShowGuideDot=0 in an individual profile to hide its in-world guide dot.
; Firearms also support AimPitchDegrees and AimYawDegrees. A negative aim
; pitch lowers both the bullet ray and reticle; yaw adjusts them horizontally.
; Firearms use ShowMuzzleFlash/MuzzleFlashSizePercent and
; ShowMuzzleSmoke/MuzzleSmokeSizePercent for the tracked barrel effects.
; Both effects follow the same calibrated ray as bullets. Stun Gun smoke is
; disabled by default because it has no powder discharge.

; Optional immersive left hand rendered from sh3vr_lefthand.mesh.
; These values are independent from every weapon profile below.
[LeftHand]
Enabled=1
ScalePercent=100
PositionX=0
PositionY=0
PositionZ=0
RotationPitchDegrees=0
RotationYawDegrees=0
RotationRollDegrees=0

[Knife]
ShowGuideDot=1
ScalePercent=70
PositionX=0
PositionY=0
PositionZ=0
RotationPitchDegrees=90
RotationYawDegrees=90
RotationRollDegrees=45

[Steel Pipe]
ShowGuideDot=1
ScalePercent=100
PositionX=0
PositionY=0
PositionZ=0
RotationPitchDegrees=90
RotationYawDegrees=90
RotationRollDegrees=45

