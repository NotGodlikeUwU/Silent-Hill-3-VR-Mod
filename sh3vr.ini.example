[OpenXR]
; Auto = launcher override, then running SteamVR, then Virtual Desktop, then system.
; Manual overrides: System or SteamVR. Selection is fixed until game restart.
Runtime=Auto
; Optional absolute path to SteamVR/steamxr_win64.json if automatic discovery fails.
SteamVRRuntimePath=
; SteamVR controls its own refresh rate when XR_FB_display_refresh_rate is absent.
; Set both to 0 to use the runtime recommendation.
EyeWidth=1900
EyeHeight=2076
MSAASamples=1
EnableFXAA=1
TargetRefreshRate=90
RequestRefreshRate=1

[Image]
; Keep the current per-eye post-process path enabled.
EnableGamePostProcess=1
GamePostProcessStrength=0.00
GamePostProcessContrast=0.88
GamePostProcessExposureStops=0.00
EnableColorCorrection=1
ExposureStops=1.5
Contrast=1.0
Saturation=1.0
VignetteStrength=0.5

[Performance]
; Enable the PC Fix D3D12 backend before D3D8 starts when the matching x86
; D3D9On12 system component is available. This avoids the slow GPU-to-CPU
; stereo fallback. Set to 0 only when troubleshooting PC Fix compatibility.
AutoEnablePcFixD3D12=1
; Parallelize the two large CPU eye-frame memory transfers when the automatic
; D3D8 compatibility transport is active. Graphics API calls stay on the game
; render thread for stability. Set to 0 only for troubleshooting.
MulticoreRendering=1

[Timing]
; Stable PC Fix timing path. Do not enable the experimental alternatives
; unless you are testing a matching development build.
UseThirteenAGFrameRateFix=1
FixedStep90Test=0
ProxyPresentationUnlock90Hz=0
ProxyNativeTimingUnlock90Hz=0
ProxyFrameTimeOverride90Hz=0
ProxyVirtualFPSMode4=1

[Stereo]
; Eye-frame transport is selected automatically. D3D12 shared textures are
; preferred; a D3D8 shared-memory stereo fallback is used when unavailable.
EnablePerDrawReplay=1
ReplayWorldOnly=0
; Base ceiling for ordinary stereo replay. Character-heavy scenes use the
; separate indexed ceiling below so NPC material batches do not trigger the
; much more expensive full-scene fallback.
PerDrawReplayBudget=384
IndexedReplayBudget=768
; Keep the original game pass wide enough that geometry behind the desktop
; heading is submitted before native-eye replay. Set 0 only for diagnostics.
EnableCullingGuardband=1
EnableFullPassStereo=0

[CameraMod]
; Automatically load Camera Mod's built-in First Person preset and enable the
; camera mod after tracking is active and the complete native event has ended.
; Multi-part cutscenes stay protected across inner cleanup/loading transitions.
; Native cutscenes temporarily suspend it; skipping needs no fixed delay.
; Set to 0 to disable automatic camera management.
AutoLoadFirstPerson=1

[Roomscale]
; Every physical OpenXR X/Z delta moves Heather through the actual game-camera
; world basis. The HMD position is converted to a body-centre position using
; a 12 cm neck-pivot compensation, so turning in place does not move Heather.
; Genuine roomscale steps remain metric 1:1.
Enable=1
; Normalize every standing player to Heather's canonical 165 cm body height.
PlayerHeightCm=165

[Input]
; Experimental shader-based head-tracked flashlight. Disabled because the
; visible flashlight follows Heather rather than the tested shader constants.
HeadTrackedFlashlight=0
; Apply horizontal turns to Camera Mod's own yaw while OTSMod.dll is loaded.
; This keeps stereo rendering and character-relative movement aligned.
EnableCameraModRightStick=1
; 0 = Snap turn, 1 = Smooth turn.
CameraModTurnMode=1
; Stick activation threshold expressed as a percentage from 20 to 95.
CameraModSnapTurnActivation=65
; Exact snap angle in degrees, independent of Camera Mod mouse sensitivity.
CameraModSnapTurnDegrees=45
; Smooth-turn maximum angular speed and radial stick deadzone.
CameraModSmoothTurnSpeed=120
CameraModSmoothTurnDeadzone=20
; Keep Heather's locomotion heading synchronized with Camera Mod yaw. This
; turns left/right into camera-relative lateral strafe instead of rotating
; Heather and her flashlight toward the movement direction.
CameraRelativeStrafe=1

[MotionControls]
; Hold the game's aim state automatically while the right trigger fires.
; The left trigger remains available as a separate manual aim control.
RightTriggerAutoAim=1
; The mouse path rotates Camera Mod's view rather than the weapon, so it stays
; disabled while the direct SH3 weapon-vector integration is developed.
EnableRightHandAim=0
; Mouse counts submitted for each degree of controller aim correction.
; Increase only if the in-game weapon turns less than the controller.
AimMouseCountsPerDegree=6
; Disabled legacy read-only character-layout probe. The known PS2 layout does
; not match the PC executable and enabling it can cause a multi-second hitch.
WeaponScanDiagnostics=0
; Temporary read-only render probe. Set to 1 only while identifying a weapon
; model, then return it to 0. Press the right grip during active gameplay.
WeaponRenderProbe=0
; Attach supported weapon models to the tracked right controller.
; Keep enabled for motion-controlled melee and firearms.
EnableWeaponPosePrototype=1
; Apply the controller orientation and per-weapon calibration profile.
WeaponPoseRotation=1
; Do not enable until the complete hierarchy of the selected weapon is known.
WeaponPoseRotateSecondaryBone=0
; Use the right controller as the absolute visual root instead of layering its
; movement over Heather's original weapon animation.
WeaponPoseAbsolutePosition=1
; Keep HMD, weapon, and hand tracking on one OpenXR prediction per game frame.
; This prevents tracked meshes from flickering and removes pose micro-jumps.
FrameCoherentTrackedMeshes=1
; Apply a medium-strength recoil pulse to the right controller for each
; confirmed firearm discharge. Automatic fire follows the native shot cadence.
FirearmHaptics=1
FirearmHapticsDurationMs=80
FirearmHapticsAmplitudePercent=50
; Per-weapon size, position, and rotation are configured in
; sh3vr_weapons.ini.
; Detect right-hand grip velocity and inject one normal game attack pulse.
; This uses SH3's own combat path and works with every equipped melee weapon.
MeleeMotion=1
; Minimum speed of the weapon's striking end in millimetres per second.
; Both this speed and the travel distance below must be reached.
MeleeSwingSpeedMmPerSecond=2800
; Minimum path travelled by the striking end before an attack can trigger.
; This rejects short controller twitches even if their peak speed is high.
MeleeSwingMinTravelMm=300
; Minimum straight-line displacement during the same swing. This prevents
; shaking or circling the wrist in place from accumulating into an attack.
MeleeSwingMinNetTravelMm=220
; Minimum time between detected swings.
MeleeSwingCooldownMs=280
; Easier knife-only gesture. These values do not weaken the pipe, katana, or
; maul thresholds above. The knife also uses a wider blade-centred hit capsule.
KnifeSwingSpeedMmPerSecond=1750
KnifeSwingMinTravelMm=140
KnifeSwingMinNetTravelMm=90
KnifeSwingCooldownMs=220
; Vibrate both OpenXR controllers when Heather's actual health decreases.
DamageHaptics=1
; Feedback duration and strength. 3000 ms is three seconds.
DamageHapticsDurationMs=3000
DamageHapticsAmplitudePercent=100

[Debug]
; Draw controller P/Y/R after each completed OpenXR eye image.
ControllerOrientationOverlay=0
